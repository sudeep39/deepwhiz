OPENAI_API_KEY=
# Default provider when a browser/CLI has not explicitly selected one
AI_PROVIDER=openai
NEBIUS_API_KEY=
NEBIUS_CHAT_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
NEBIUS_JUDGE_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
NEBIUS_EMBEDDING_DIMENSIONS=4096
# Separate embedding space; never point Nebius to the OpenAI index
PINECONE_NEBIUS_INDEX=finwhiz-nebius-v1
PINECONE_API_KEY=
PINECONE_INDEX=finwhiz-filings-v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Optional separate model for automated evaluation; manual review remains required
OPENAI_JUDGE_MODEL=gpt-4.1-mini
# Set to your app name and contact email before live SEC freshness checks
SEC_USER_AGENT=
APP_PASSWORD=
# Directory for uploads, processing state, and cache; use persistent storage when hosting
# Import a legacy .runtime with run.py migrate before switching this setting.
FINWHIZ_DATA_DIR=.runtime-python
PORT=3100
HOST=0.0.0.0
# Interactive research limits (seconds); shared by all stages/retries of a chat.
CHAT_TIMEOUT_SECONDS=60
VECTOR_TIMEOUT_SECONDS=8
EMBEDDING_TIMEOUT_SECONDS=15
GENERATION_TIMEOUT_SECONDS=30
ANSWER_REPAIR_TIMEOUT_SECONDS=12
RERANK_TIMEOUT_SECONDS=10
PROVIDER_ATTEMPTS=2
# Oversized reranking falls back to hybrid ranking, preserving its candidates.
RERANK_MAX_TOKENS=12000
ANSWER_MAX_TOKENS=20000
# Bounded agentic evidence gathering; false restores one-pass hybrid research.
AGENTIC_RAG_ENABLED=true
AGENT_MAX_ROUNDS=2
AGENT_TIMEOUT_SECONDS=8
AGENT_MAX_TOKENS=8000
AGENT_ANSWER_RESERVE_SECONDS=20
# Set to share the deployed library rather than start an independent local backend.
FINWHIZ_BACKEND_URL=
# Optional operator credential for read-only registry audits and cleanup; never sent to the browser.
FINWHIZ_SHARED_BACKEND_PASSWORD=
# Optional empty-registry recovery. Replit launch configuration supplies these.
FINWHIZ_BOOTSTRAP_LIBRARY=
FINWHIZ_BOOTSTRAP_SHA256=

# Explicit browser origins when a trusted proxy preserves a different public origin. JSON array; never use a wildcard.
ALLOWED_ORIGINS=[]

# Overall SEC import budget, in seconds (maximum 100); downloads are streamed with per-response size limits.
SEC_IMPORT_TIMEOUT_SECONDS=90

# Durable library checkpointing: create/select a Replit App Storage bucket first.
FINWHIZ_CLOUD_LIBRARY=false
FINWHIZ_STORAGE_BUCKET_ID=
FINWHIZ_LIBRARY_PREFIX=deepwhiz/library-v1
# One-time verified archive restore; never overwrites a nonempty registry.
FINWHIZ_LIBRARY_RESTORE_PATH=
FINWHIZ_LIBRARY_RESTORE_SHA256=
