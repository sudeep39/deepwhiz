{
  "name": "deepwhiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/python-command.mjs serve",
    "dev:frontend": "node scripts/frontend-server.mjs",
    "start:legacy": "node --env-file-if-exists=.env server.mjs",
    "refresh": "node scripts/python-command.mjs collect --apply",
    "download": "node scripts/python-command.mjs download --apply",
    "pinecone:plan": "node scripts/python-command.mjs index",
    "pinecone:create": "node scripts/python-command.mjs index --apply",
    "test": "node --test filings.test.mjs pinecone.test.mjs web.test.mjs review.test.mjs rubric.test.mjs provider.test.mjs",
    "evaluate": "node scripts/python-command.mjs evaluate",
    "ingest:evaluation": "node scripts/python-command.mjs ingest",
    "freshness": "node scripts/python-command.mjs freshness",
    "score:reviews": "node scripts/python-command.mjs score-reviews",
    "export:project": "node scripts/python-command.mjs export-project --apply",
    "test:python": "node scripts/python-command.mjs --test",
    "test:browser": "node scripts/browser-check-python.mjs",
    "test:browser:legacy": "node scripts/browser-check.mjs",
    "test:documents:browser": "node scripts/check-documents-ui.mjs",
    "test:research:browser": "node scripts/check-research-ui.mjs",
    "test:proxy": "node --test scripts/frontend-server.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cheerio": "^1.2.0",
    "js-tiktoken": "^1.0.21",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
