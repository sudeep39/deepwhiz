run = "FINWHIZ_BACKEND_URL= FINWHIZ_BOOTSTRAP_LIBRARY= PORT=5000 python run.py serve"
entrypoint = "run.py"
modules = ["python-3.12", "nodejs-20", "web"]

[deployment]
deploymentTarget = "vm"
run = ["sh", "-c", "FINWHIZ_BACKEND_URL= FINWHIZ_BOOTSTRAP_LIBRARY=data/recovery/replit-library-v1.json.gz FINWHIZ_BOOTSTRAP_SHA256=84e0f0b08f6bbe46d3b0891ed6003aeabe568e98e85dcb0923f7ac1c3b07b7d9 AI_PROVIDER=nebius PORT=5000 python run.py serve"]

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "FINWHIZ_BACKEND_URL= FINWHIZ_BOOTSTRAP_LIBRARY= PORT=5000 python run.py serve"
waitForPort = 5000
