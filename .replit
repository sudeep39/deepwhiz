run = "FINWHIZ_BACKEND_URL= FINWHIZ_BOOTSTRAP_LIBRARY= PORT=5000 python run.py serve"
entrypoint = "run.py"
modules = ["python-3.12", "nodejs-20", "web"]

[deployment]
deploymentTarget = "vm"
run = ["sh", "-c", "FINWHIZ_BACKEND_URL= FINWHIZ_BOOTSTRAP_LIBRARY= FINWHIZ_BOOTSTRAP_AUTO=false PORT=5000 python run.py serve"]
ignorePorts = false

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "FINWHIZ_BACKEND_URL= FINWHIZ_BOOTSTRAP_LIBRARY= PORT=5000 python run.py serve"
waitForPort = 5000
